# This is non-secret production configuration. Copy it to .env.production.
# Runtime secrets live in ../secrets.txt and are loaded by the Makefile's
# production targets; they are never copied into an image or committed.

# Lumina's one public browser origin. The VM's DNS (or its test-client hosts
# file) must resolve this name to the VM, and the TLS certificate must cover it.
PUBLIC_APP_DOMAIN=lumina.sg
FRONTEND_ALLOWED_ORIGINS=https://lumina.sg

# PEM certificate chain and matching private key on the Docker host. Keep the
# private key outside this repository; both mounts are read-only in Nginx.
TLS_CERT_PATH=../tls/fullchain.pem
TLS_KEY_PATH=../tls/privkey.pem
# false while testing the self-signed VM certificate; set true only after the
# browser trusts HTTPS and the real edge smoke test passes.
SECURITY_HEADERS_HSTS_ENABLED=false

# Non-secret application configuration. Paste the provider API key only after
# AI_ENGINE_API_KEY= in ../secrets.txt; never put it in this repository file.
# The application uses the OpenAI-compatible Chat Completions request shape, so
# either OpenAI or DeepSeek can be selected by changing this endpoint/models.
POSTGRES_USER=lumina
POSTGRES_DB=lumina
JWT_EXPIRATION_MS=86400000
# OpenAI profile (one API key serves both marking and vision/OCR requests).
AI_ENGINE_URL=https://api.openai.com/v1/chat/completions
AI_ENGINE_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini
# DeepSeek alternative:
# AI_ENGINE_URL=https://api.deepseek.com/chat/completions
# AI_ENGINE_MODEL=deepseek-v4-flash
# AI_VISION_MODEL=deepseek-v4-flash-vision-exp
