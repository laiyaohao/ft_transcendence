# Add this file after .env when starting the production Compose overlay:
# docker compose --env-file .env --env-file .env.production \
#   -f compose.yaml -f compose.production.yaml up --build -d
#
# Do not use example values in deployment. PUBLIC_APP_DOMAIN must be the one
# DNS hostname on the certificate; use the matching full HTTPS browser origin.
PUBLIC_APP_DOMAIN=replace-with-public-dns-name.example
FRONTEND_ALLOWED_ORIGINS=https://replace-with-public-dns-name.example

# Absolute host paths are safest. The certificate must be a PEM chain and the
# key must be the matching PEM private key; these files are mounted read-only.
TLS_CERT_PATH=/srv/lumina/tls/fullchain.pem
TLS_KEY_PATH=/srv/lumina/tls/privkey.pem
