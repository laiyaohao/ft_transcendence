# Copy this file to .env and replace every change-me value before starting Compose.
POSTGRES_USER=lumina
POSTGRES_PW=change-me-database-password
POSTGRES_DB=lumina

# Auth service
AUTH_DB_URL=jdbc:postgresql://localhost:5432/lumina
AUTH_DB_USERNAME=lumina
AUTH_DB_PASSWORD=change-me-database-password
AUTH_DB_SCHEMA=auth
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000
# Optional first-Tutor bootstrap. Leave all three blank to disable it.
BOOTSTRAP_TUTOR_EMAIL=
BOOTSTRAP_TUTOR_PASSWORD=
BOOTSTRAP_TUTOR_FULL_NAME=

# Grading service
GRADING_DB_URL=jdbc:postgresql://localhost:5432/lumina
GRADING_DB_USERNAME=lumina
GRADING_DB_PASSWORD=change-me-database-password
GRADING_DB_SCHEMA=grading
AI_ENGINE_URL=https://api.groq.com/openai/v1/chat/completions
AI_ENGINE_MODEL=openai/gpt-oss-20b
AI_ENGINE_API_KEY=change-me-ai-api-key
AI_VISION_MODEL=qwen/qwen3.6-27b
# Shared only between grading-service and learning-service. Generate a
# separate high-entropy value; do not use a NEXT_PUBLIC_ variable.
LEARNING_MARKING_SYNC_KEY=change-me-to-a-separate-high-entropy-service-key

# Learning service
LEARNING_DB_URL=jdbc:postgresql://localhost:5432/lumina
LEARNING_DB_USERNAME=lumina
LEARNING_DB_PASSWORD=change-me-database-password
LEARNING_DB_SCHEMA=learning

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_LEARNING_API_URL=http://localhost:8083
